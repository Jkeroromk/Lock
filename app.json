{
  "expo": {
    "name": "Lock",
    "slug": "lock",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/6bddb492-55a5-4ae0-856d-ec4b27314127",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "icon": "./assets/icons/icon-open-lock.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jkeroro.lockin",
      "appleTeamId": "KBBN9626H9",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "Lock reads your step count and active energy to display daily activity and sync it to your personal account.",
        "NSHealthUpdateUsageDescription": "Lock reads your step count and active energy from Apple Health to display your daily activity.",
        "NSCameraUsageDescription": "Lock uses the camera to photograph meals for AI-powered calorie analysis.",
        "NSPhotoLibraryUsageDescription": "Lock accesses your photo library to choose a meal photo or profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Lock saves meal photos to your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-fg-open-lock.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.jkeroro.lockin",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/icons/preview-open-lock.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lock accesses your photo library to choose meal photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lock uses the camera to photograph meals for calorie analysis."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007AFF",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "RingL",
            "ios": "./assets/icons/icon-ring-l.png",
            "android": {
              "foregroundImage": "./assets/icons/android-fg-ring-l.png",
              "backgroundColor": "#0A0A0A"
            }
          },
          {
            "name": "StickerL",
            "ios": "./assets/icons/icon-sticker-l.png",
            "android": {
              "foregroundImage": "./assets/icons/android-fg-sticker-l.png",
              "backgroundColor": "#FFD43B"
            }
          },
          {
            "name": "KeyholeDial",
            "ios": "./assets/icons/icon-keyhole-dial.png",
            "android": {
              "foregroundImage": "./assets/icons/android-fg-keyhole-dial.png",
              "backgroundColor": "#0A0A0A"
            }
          }
        ]
      ],
      "@bacons/apple-targets"
    ],
    "scheme": "lock",
    "extra": {
      "eas": {
        "projectId": "6bddb492-55a5-4ae0-856d-ec4b27314127"
      },
      "router": {}
    },
    "owner": "jkeroro"
  }
}

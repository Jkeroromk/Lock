generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Set by the Supabase ↔ Vercel integration: transaction pooler (port 6543,
  // pgbouncer=true), kept in sync by Supabase when credentials change.
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id        String   @id           // Clerk user ID: "user_2xxx"
  email     String?  @unique
  name      String?
  username   String?  @unique
  bio        String?
  avatarEmoji  String? @map("avatar_emoji")
  avatarImage  String? @map("avatar_image") @db.Text
  showGender   Boolean @default(false) @map("show_gender")
  inviteCode String? @unique @map("invite_code") // 6 letters: invite someone new (sign-up reward)
  friendCode String? @unique @map("friend_code") // 8 digits: add as a friend (needs approval)
  streak    Int      @default(0)
  height    Int?
  age       Int?
  weight    Decimal? @db.Decimal(5, 2)
  gender    String?
  goal      String?
  exerciseFrequency  String?  @map("exercise_frequency")
  expectedTimeframe  String?  @map("expected_timeframe")
  hasCompletedOnboarding Boolean @default(false) @map("has_completed_onboarding")
  plan         String   @default("FREE") // FREE | PRO | MAX — written only from RevenueCat (lib/revenuecat.ts)
  subscription String?  // RevenueCat subscription product ID
  aiCallsToday    Int      @default(0) @map("ai_calls_today")
  aiCallsResetAt  DateTime @default(now()) @map("ai_calls_reset_at") @db.Timestamptz(6)
  lastDietAnalysisAt DateTime? @map("last_diet_analysis_at") @db.Timestamptz(6)
  dietAnalysisLangs  String?   @map("diet_analysis_langs") // languages already reviewed on that day, comma-separated
  bonusAiCalls    Int      @default(0) @map("bonus_ai_calls") // earned from invites, spent after the daily allowance
  inviteRewards   Int      @default(0) @map("invite_rewards")  // how many invites have paid out (capped)
  referredById    String?  @map("referred_by_id")             // who invited this user; set once
  pushToken       String?  @map("push_token")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  meals                 Meal[]
  healthSyncs           HealthSync[]
  sentFriendRequests    Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
  challenges            ChallengeParticipant[]
  createdChallenges     Challenge[]
  activityFeed          ActivityFeed[]
  weightRecords         WeightRecord[]
  posts                 Post[]
  postLikes             PostLike[]
  postComments          PostComment[]
  postReports           PostReport[]
  blocksMade            UserBlock[]  @relation("BlockBlocker")
  blockedBy             UserBlock[]  @relation("BlockBlocked")
  gameProfile           GameProfile?
  creatures             Creature[]
  encounters            Encounter[]

  @@map("users")
}

model Meal {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  foodName  String   @map("food_name")
  calories  Decimal  @default(0) @db.Decimal(10, 2)
  protein   Decimal? @default(0) @db.Decimal(10, 2)
  carbs     Decimal? @default(0) @db.Decimal(10, 2)
  fat       Decimal? @default(0) @db.Decimal(10, 2)
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("meals")
}

model Friendship {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @map("requester_id")
  addresseeId String   @map("addressee_id")
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@map("friendships")
}

model Challenge {
  id          String   @id @default(uuid()) @db.Uuid
  creatorId   String   @map("creator_id")
  title       String
  description String?
  type        String   @default("CALORIES") // CALORIES, STREAK, STEPS
  goalValue   Int      @map("goal_value")
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator      User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@index([creatorId])
  @@map("challenges")
}

model ChallengeParticipant {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id")
  progress    Int      @default(0)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
  @@map("challenge_participants")
}

model ActivityFeed {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  type      String   // MEAL_LOGGED, GOAL_REACHED, STREAK_MILESTONE, CHALLENGE_JOINED, CHALLENGE_COMPLETED
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_feed")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  content   String   @db.Text
  mediaUrl  String?  @map("media_url") @db.Text
  hiddenAt  DateTime? @map("hidden_at") @db.Timestamptz(6) // set when auto-hidden by reports; author still sees it
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]
  reports  PostReport[]

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("post_comments")
}

model PostReport {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  reporterId String  @map("reporter_id")
  reason    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([postId])
  @@index([reporterId])
  @@map("post_reports")
}

// A blocks B: they disappear from each other's social surfaces, any
// friendship/request between them is removed, and B can't re-request A.
model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model WeightRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id")
  weight     Decimal  @db.Decimal(5, 2)        // kg
  note       String?
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
  @@map("weight_records")
}

model Food {
  id        String   @id @default(uuid()) @db.Uuid
  name      String                                    // 食物名称（中文或英文）
  nameEn    String?  @map("name_en")                 // 英文名（来自 USDA）
  calories  Decimal  @db.Decimal(10, 2)              // kcal per 100g
  protein   Decimal  @default(0) @db.Decimal(10, 2)  // g per 100g
  carbs     Decimal  @default(0) @db.Decimal(10, 2)  // g per 100g
  fat       Decimal  @default(0) @db.Decimal(10, 2)  // g per 100g
  source    String   @default("LOCAL")               // LOCAL | USDA
  fdcId     String?  @unique @map("fdc_id")          // USDA FoodData Central ID
  cachedAt  DateTime? @map("cached_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([name])
  @@index([source])
  @@map("foods")
}

model HealthSync {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  date         DateTime @db.Date
  steps        Int      @default(0)
  activeEnergy Decimal  @default(0) @map("active_energy") @db.Decimal(10, 2)
  heartRate    Int      @default(0) @map("heart_rate")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("health_sync")
}

// ── Lockling (game) ──────────────────────────────────────────────────────────
// Real habits drive the game: logging a meal can bring an encounter, steps hatch
// eggs, days logged grow the partner. Species and numbers live in lib/game/species.ts.

model GameProfile {
  userId      String   @id @map("user_id")
  stageSeen   Int      @default(0) @map("stage_seen")   // avatar milestones the app has already celebrated
  look        String?  @db.Text                        // avatar look (JSON); null until the player makes one
  avatarName  String?  @map("avatar_name")
  eggBaseline Int      @default(0) @map("egg_baseline") // lifetime steps when the current egg was laid
  eggsHatched Int      @default(0) @map("eggs_hatched")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_profiles")
}

model Creature {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id")
  species  String
  shiny    Boolean  @default(false)
  origin   String   // MEAL | WATER | EGG
  caughtAt DateTime @default(now()) @map("caught_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("creatures")
}

model Encounter {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id")
  species   String
  shiny     Boolean   @default(false)
  origin    String    // MEAL | WATER
  refKey    String    @unique @map("ref_key") // meal:<id> or water:<user>:<day>, so each source pays once
  dayKey    String    @map("day_key")         // user's local YYYY-MM-DD, for the daily cap
  status    String    @default("PENDING")     // PENDING | CAUGHT
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  caughtAt  DateTime? @map("caught_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
  @@index([userId, status])
  @@map("encounters")
}
